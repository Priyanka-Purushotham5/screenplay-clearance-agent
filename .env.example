# Copy this file to .env and fill in your credentials
# CRITICAL: Make sure .env is in .gitignore BEFORE your first commit
# Never commit .env — it contains secrets

# --- Database -------------------------------------------------------------
# Use the value below when running with docker compose up.
# For verify_a3.py outside Docker, keep localhost:5432.
DATABASE_URL=postgresql+asyncpg://clearance:clearance@localhost:5432/clearance

# --- Google Cloud ---------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Two auth paths:
#   - Local (GOOGLE_GENAI_USE_VERTEXAI=0): the SDK reads GEMINI_API_KEY below.
#   - Docker (GOOGLE_GENAI_USE_VERTEXAI=true): Application Default Credentials,
#     mounted from ~/.config/gcloud. Run this on the host first:
#       gcloud auth application-default login
#     No service-account key file needed, and nothing secret to leak.
GOOGLE_GENAI_USE_VERTEXAI=0

# --- Keys -----------------------------------------------------------------
# Leave blank here. Put real values in .env, which is gitignored.
PARALLEL_API_KEY=
GEMINI_API_KEY=

# Windows keeps ADC in %APPDATA%\gcloud, not ~/.config/gcloud, so point the
# compose bind mount at it explicitly. Forward slashes, no quotes:
#   GCLOUD_CONFIG_DIR=C:/Users/Priyanka/AppData/Roaming/gcloud
GCLOUD_CONFIG_DIR=

# --- Models ---------------------------------------------------------------
# Flash for extraction: high volume, structural task, cost matters.
# Pro for assessment: low volume, judgement-heavy, quality matters.
EXTRACTION_MODEL=gemini-2.5-flash
# Assessment wants a Pro-tier model, but gemini-2.5-pro now 404s for
# newly-issued API keys ("no longer available to new users"). Flash is what
# a fresh key can reach. If yours has Pro access, set it here.
ASSESSMENT_MODEL=gemini-2.5-flash

# --- Rate limits ----------------------------------------------------------
# Per-run budget guards, not Google's quota. The 20-call default is spent
# before research finishes on even a short script; raise it for a real run.
GEMINI_RPM=10
GEMINI_DAILY=300
PARALLEL_RPM=30
PARALLEL_DAILY=500

# --- Frontend -------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
